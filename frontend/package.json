{
  "name": "jyotish-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:chart-geometry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-north-chart-geometry.mjs",
    "typecheck": "tsc --noEmit",
    "test:entities": "node scripts/check-entity-foundation.mjs",
    "test:relationships": "node scripts/check-relationship-foundation.mjs",
    "test:interactions": "node scripts/check-interactions-foundation.mjs",
    "test:compatibility": "node scripts/check-compatibility-foundation.mjs",
    "test:reports": "node scripts/check-reports-foundation.mjs",
    "test:report-recipes": "node scripts/check-report-recipes.mjs",
    "test:report-evidence": "node scripts/check-report-evidence.mjs",
    "test:report-evidence-snapshot": "node scripts/check-report-evidence-snapshot.mjs",
    "test:sources": "node scripts/check-sources-foundation.mjs",
    "test:provenance": "node scripts/check-provenance-foundation.mjs",
    "test:ai-eligibility": "node scripts/check-ai-eligibility-gate.mjs",
    "test:ai-contract": "node scripts/check-ai-contract-dry-run.mjs",
    "test:ai-contract-snapshot": "node scripts/check-ai-contract-snapshot.mjs",
    "test:ai-gateway": "node scripts/check-ai-gateway.mjs",
    "production-check": "node scripts/production-check.mjs",
    "build:prod": "next build && npm run production-check",
    "audit:workbench": "node scripts/audit-workbench-architecture.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
