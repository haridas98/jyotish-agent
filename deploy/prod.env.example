DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=jyotish.example.com,127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://jyotish.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://jyotish.example.com
DJANGO_SECURE_PROXY_SSL_HEADER=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_AGE=2592000
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
DJANGO_SESSION_SAVE_EVERY_REQUEST=true
PRIVATE_APP_REQUIRE_AUTH=true

POSTGRES_DB=jyotish_agent
POSTGRES_USER=jyotish
POSTGRES_PASSWORD=replace-with-db-password
REDIS_URL=redis://redis:6379/0

VL_DATABASE_URL=
VL_PUBLIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
CODEX_ANALYSIS_PROVIDER=openai
QWEN_API_BASE_URL=http://localhost:3264/api
QWEN_API_KEY=dummy-key
QWEN_MODEL=qwen3.7-max
QWEN_TIMEOUT_SECONDS=420
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_HTTP_REFERER=https://jyotish.example.com
OPENROUTER_APP_TITLE=Jyotish Agent
OPENROUTER_TIMEOUT_SECONDS=420
OPENROUTER_NEMOTRON_MAX_TOKENS=5000

SWISSEPH_EPHE_PATH=/app/ephe
SWISSEPH_JPL_FILE=
JHORA_ACCURACY_REPORT_PATH=/app/.tmp/jhora/sterlitamak-1998/accuracy-report.json

NEXT_PUBLIC_API_BASE_URL=https://jyotish.example.com
NEXT_PUBLIC_PRIVATE_APP_REQUIRE_AUTH=true

JYOTISH_BACKEND_PORT=18100
JYOTISH_FRONTEND_PORT=13130
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=600
