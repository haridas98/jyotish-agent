[Unit]
Description=FreeQwenApi local proxy for jyotish-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/FreeQwenApi
Environment=HOST=127.0.0.1
Environment=PORT=3264
Environment=NON_INTERACTIVE=1
Environment=SKIP_ACCOUNT_MENU=true
ExecStart=/usr/bin/node /opt/FreeQwenApi/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
