[Unit]
Description=FreeDeepseekAPI local proxy for jyotish-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/FreeDeepseekAPI
Environment=HOST=127.0.0.1
Environment=PORT=9655
Environment=NON_INTERACTIVE=1
Environment=DEEPSEEK_AUTH_PATH=/opt/FreeDeepseekAPI/deepseek-auth.json
ExecStart=/usr/bin/node /opt/FreeDeepseekAPI/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
