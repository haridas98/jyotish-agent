DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3130,http://localhost:3130
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3130,http://localhost:3130
DJANGO_SECURE_PROXY_SSL_HEADER=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
PRIVATE_APP_REQUIRE_AUTH=false

DATABASE_URL=postgres://jyotish:jyotish@127.0.0.1:55439/jyotish_agent
REDIS_URL=redis://127.0.0.1:6382/0

# Optional read-only connection to C:\Projects\vl Postgres.
VL_DATABASE_URL=
VL_PUBLIC_BASE_URL=http://127.0.0.1:3001

# Optional LLM generation for reviewed draft reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
CODEX_ANALYSIS_PROVIDER=codex_cli

# Optional high-precision JPL mode for Swiss Ephemeris.
# Put de441.eph/de431.eph in this directory and send ephemeris=jpl in chart input.
SWISSEPH_EPHE_PATH=
SWISSEPH_JPL_FILE=

# Optional local JHora comparison report shown in the Accuracy tab.
JHORA_ACCURACY_REPORT_PATH=.tmp/jhora/sterlitamak-1998/accuracy-report.json

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100
NEXT_PUBLIC_PRIVATE_APP_REQUIRE_AUTH=false
