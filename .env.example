DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3130,http://localhost:3130
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3130,http://localhost:3130
DJANGO_SECURE_PROXY_SSL_HEADER=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
PRIVATE_APP_REQUIRE_AUTH=false

DATABASE_URL=postgres://jyotish:jyotish@127.0.0.1:55439/jyotish_agent
REDIS_URL=redis://127.0.0.1:6382/0

# Optional read-only connection to C:\Projects\vl Postgres.
VL_DATABASE_URL=
VL_PUBLIC_BASE_URL=http://127.0.0.1:3001

# Optional LLM generation for reviewed draft reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
CODEX_ANALYSIS_PROVIDER=codex_cli
QWEN_API_BASE_URL=http://localhost:3264/api
QWEN_API_KEY=dummy-key
QWEN_MODEL=qwen3.7-max
QWEN_TIMEOUT_SECONDS=420
FREE_DEEPSEEK_API_BASE_URL=http://localhost:9655/v1
FREE_DEEPSEEK_API_KEY=dummy-key
FREE_DEEPSEEK_MODEL=deepseek-chat
FREE_DEEPSEEK_TIMEOUT_SECONDS=420
FREE_DEEPSEEK_MAX_TOKENS=5000
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Jyotish Agent
NEMOTRON_ANALYSIS_ENABLED=false
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
NEMOTRON_TIMEOUT_SECONDS=420
NEMOTRON_MAX_TOKENS=5000

# Optional high-precision JPL mode for Swiss Ephemeris.
# Put de441.eph/de431.eph in this directory and send ephemeris=jpl in chart input.
SWISSEPH_EPHE_PATH=
SWISSEPH_JPL_FILE=

# Optional local JHora comparison report shown in the Accuracy tab.
JHORA_ACCURACY_REPORT_PATH=.tmp/jhora/sterlitamak-1998/accuracy-report.json
JHORA_WITNESS_CASE_PATH=.tmp/jhora/batch-queue/sterlitamak-1998-04-30-1345
WITNESS_REVIEW_BATCH_INDEX_PATH=.tmp/witness-review/_index.json
WITNESS_CAPTURE_QUEUE_PATH=.tmp/witness-review/capture-queue.json
PARASHARA_LIGHT_PACKET_PATH=.tmp/pl7/haridas-verification-packet/packet.json
PARASHARA_LIGHT_MANUAL_WITNESS_VALUES_PATH=.tmp/pl7/haridas-manual-values-template.json
PARASHARA_LIGHT_PROFILE_REPORT_PATH=.tmp/pl7/haridas-pl-profile-report.json
PARASHARA_LIGHT_FORENSIC_REPORT_PATH=.tmp/pl7/haridas-pl-swiss-forensic-dump.json
PARASHARA_LIGHT_SETTINGS_EVIDENCE_PATH=.tmp/pl7/haridas-pl-settings-evidence.json
PARASHARA_LIGHT_VISIBLE_SETTINGS_CAPTURE_PATH=.tmp/pl7/haridas-pl-visible-settings-capture.json
PARASHARA_LIGHT_CALCULATION_OPTIONS_REPORT_PATH=.tmp/pl7/haridas-pl-calculation-options-report.json
PARASHARA_LIGHT_SETTINGS_AWARE_FORENSIC_PATH=.tmp/pl7/haridas-pl-settings-aware-forensic.json
PARASHARA_LIGHT_PREFERENCES_INVENTORY_PATH=.tmp/pl7/haridas-pl-preferences-inventory.json
PARASHARA_LIGHT_HIDDEN_OPTION_STORE_PATH=.tmp/pl7/haridas-pl-hidden-option-store.json
PARASHARA_LIGHT_OPTION_STORE_DIFF_PATH=.tmp/pl7/haridas-pl-option-store-diff.json
PARASHARA_LIGHT_INTERNAL_SETTINGS_AUDIT_PATH=.tmp/pl7/haridas-pl-internal-settings-audit.json

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100
NEXT_PUBLIC_PRIVATE_APP_REQUIRE_AUTH=false
NEXT_PUBLIC_ENABLE_NEMOTRON=false
